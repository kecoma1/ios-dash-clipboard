    "Add Clipboard in Settings > General > Keyboard > Keyboards > Add New Keyboard." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade Clipboard en Ajustes > General > Teclado > Teclados > Añadir nuevo teclado." } } } },

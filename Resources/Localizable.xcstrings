    "Saved snippets can’t be read. Existing data was left unchanged." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pueden leer los textos guardados. Los datos existentes no se modificaron." } } } },
    "Search snippets" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Buscar textos" } } } },

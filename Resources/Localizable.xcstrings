    "Save from clipboard or create snippets in the app." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guarda texto copiado o crea textos en la app." } } } },
    "Save text snippets and insert them from your clipboard." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Guarda textos e insértalos desde tu portapapeles." } } } },
